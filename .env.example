# Development-only absolute tool/model paths. Do not commit secrets or customer
# media paths. Omit the FFmpeg variables to use the development PATH fallback.
# Desktop release builds set all three to reviewed bundled resources.
# AISTEREO_FFMPEG_PATH=C:\path\to\ffmpeg.exe
# AISTEREO_FFPROBE_PATH=C:\path\to\ffprobe.exe
# AISTEREO_DEPTH_MODEL_PATH=C:\path\to\reviewed-vda-small-adapter.torchscript

# Optional, opt-in LLM preset recommendations. Prefer the app's OS credential
# store in desktop builds; environment variables are for development only.
# AISTEREO_LLM_API_KEY=
