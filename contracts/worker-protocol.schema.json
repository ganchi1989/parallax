{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parallaxforge.local/schemas/worker-protocol-1.0.json",
  "title": "Parallax Forge worker protocol",
  "$defs": {
    "appIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "App-generated operation prefix plus canonical UUID v4. The Rust host also requires the prefix to match the request method.",
      "pattern": "^(ping|create-project|inspect|normalize|detect-shots|analyze-draft|estimate-depth|extract-features|create-stereo-script|direct|preview|export|render|generate-qc|qc|run-pipeline|run|open-project|llm-status|llm-test|recommend|save-script|cancel)-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "identifier": {
      "oneOf": [
        { "$ref": "#/$defs/appIdentifier" },
        { "const": "worker-lifecycle" }
      ]
    },
    "method": {
      "enum": [
        "ping",
        "create_project",
        "inspect",
        "normalize",
        "detect_shots",
        "analyze_draft",
        "estimate_depth",
        "extract_features",
        "create_stereo_script",
        "direct",
        "render_preview",
        "render_final",
        "render",
        "generate_qc",
        "qc",
        "run_pipeline",
        "run",
        "get_project",
        "llm_status",
        "test_llm",
        "recommend_preset",
        "apply_shot_overrides",
        "cancel",
        "cancel_job"
      ]
    },
    "stereoParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depth_strength",
        "convergence_depth_percentile",
        "max_background_disparity_norm",
        "max_popout_disparity_norm",
        "temporal_smoothing",
        "transition_frames",
        "edge_protection"
      ],
      "properties": {
        "depth_strength": { "type": "number", "minimum": 0, "maximum": 2 },
        "convergence_depth_percentile": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_background_disparity_norm": { "type": "number", "minimum": 0, "maximum": 0.05 },
        "max_popout_disparity_norm": { "type": "number", "minimum": 0, "maximum": 0.05 },
        "temporal_smoothing": { "type": "number", "minimum": 0, "maximum": 1 },
        "transition_frames": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "edge_protection": { "type": "boolean" }
      }
    },
    "shotOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_id", "preset", "parameters"],
      "properties": {
        "shot_id": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "preset": {
          "enum": ["dialogue_subtle", "action_controlled", "vista_deep", "closeup_flat", "neutral"]
        },
        "parameters": { "$ref": "#/$defs/stereoParameters" }
      }
    },
    "applyShotOverridesParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_dir", "expected_revision", "overrides"],
      "properties": {
        "project_dir": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "expected_revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "overrides": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/shotOverride" }
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "projectName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*\\S[^\\u0000-\\u001F\\u007F-\\u009F]*$"
    },
    "model": {
      "const": "gpt-5.6-terra"
    },
    "depthBackend": {
      "enum": [
        "synthetic",
        "cached",
        "video-depth-anything-small",
        "vda-small",
        "video-depth-anything"
      ]
    },
    "device": {
      "enum": ["auto", "cpu", "cuda", "mps"]
    },
    "draftProfile": {
      "const": "representative_frames"
    },
    "forceStages": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "enum": [
          "inspect",
          "normalize",
          "detect_shots",
          "analyze_draft",
          "estimate_depth",
          "extract_features",
          "direct",
          "render_preview",
          "render_final",
          "qc"
        ]
      }
    },
    "emptyParams": {
      "type": "object",
      "additionalProperties": false
    },
    "llmParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "$ref": "#/$defs/model" }
      }
    },
    "shotFeatures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "duration_seconds",
        "motion_score",
        "speech_ratio",
        "depth_spread",
        "foreground_ratio",
        "brightness",
        "cut_frequency_context"
      ],
      "properties": {
        "shot_id": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "duration_seconds": { "type": "number", "minimum": 0, "maximum": 604800 },
        "motion_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "speech_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "depth_spread": { "type": "number", "minimum": 0, "maximum": 1 },
        "foreground_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "brightness": { "type": "number", "minimum": 0, "maximum": 1 },
        "cut_frequency_context": { "type": "number", "minimum": 0, "maximum": 1 },
        "camera_movement": { "enum": ["static", "lateral", "vertical", "zoom", "unstable"] },
        "depth_reliability": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "recommendParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features"],
      "properties": {
        "features": { "$ref": "#/$defs/shotFeatures" },
        "model": { "$ref": "#/$defs/model" }
      }
    },
    "cancelParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id"],
      "properties": {
        "job_id": { "$ref": "#/$defs/appIdentifier" }
      }
    },
    "createProjectParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_path", "project_dir"],
      "properties": {
        "input_path": { "$ref": "#/$defs/path" },
        "project_dir": { "$ref": "#/$defs/path" },
        "name": { "$ref": "#/$defs/projectName" },
        "depth_backend": { "$ref": "#/$defs/depthBackend" },
        "device": { "$ref": "#/$defs/device" },
        "anaglyph_mode": { "enum": ["basic", "calibrated"] },
        "swap_eyes": { "type": "boolean" },
        "llm_enabled": { "type": "boolean" },
        "model": { "$ref": "#/$defs/model" }
      }
    },
    "inspectParams": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_path"],
          "properties": { "input_path": { "$ref": "#/$defs/path" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_dir"],
          "properties": {
            "project_dir": { "$ref": "#/$defs/path" },
            "resume": { "type": "boolean" },
            "force_stages": { "$ref": "#/$defs/forceStages" }
          }
        }
      ]
    },
    "projectStageParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_dir"],
      "properties": {
        "project_dir": { "$ref": "#/$defs/path" },
        "resume": { "type": "boolean" },
        "force_stages": { "$ref": "#/$defs/forceStages" }
      }
    },
    "analyzeDraftParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_dir"],
      "properties": {
        "project_dir": { "$ref": "#/$defs/path" },
        "resume": { "type": "boolean" },
        "force_stages": { "$ref": "#/$defs/forceStages" },
        "depth_backend": { "$ref": "#/$defs/depthBackend" },
        "device": { "$ref": "#/$defs/device" },
        "profile": { "$ref": "#/$defs/draftProfile" },
        "allow_fallback": { "type": "boolean" }
      }
    },
    "estimateDepthParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_dir"],
      "properties": {
        "project_dir": { "$ref": "#/$defs/path" },
        "resume": { "type": "boolean" },
        "force_stages": { "$ref": "#/$defs/forceStages" },
        "depth_backend": { "$ref": "#/$defs/depthBackend" },
        "backend": { "$ref": "#/$defs/depthBackend" },
        "device": { "$ref": "#/$defs/device" },
        "cache_dir": { "$ref": "#/$defs/path" },
        "allow_fallback": { "type": "boolean" }
      }
    },
    "extractFeaturesParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_dir"],
      "properties": {
        "project_dir": { "$ref": "#/$defs/path" },
        "resume": { "type": "boolean" },
        "force_stages": { "$ref": "#/$defs/forceStages" },
        "depth_backend": { "$ref": "#/$defs/depthBackend" },
        "device": { "$ref": "#/$defs/device" },
        "speech_intervals": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              { "type": "number", "minimum": 0, "maximum": 604800 },
              { "type": "number", "minimum": 0, "maximum": 604800 }
            ],
            "items": false
          }
        }
      }
    },
    "directParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_dir"],
      "properties": {
        "project_dir": { "$ref": "#/$defs/path" },
        "resume": { "type": "boolean" },
        "force_stages": { "$ref": "#/$defs/forceStages" },
        "depth_backend": { "$ref": "#/$defs/depthBackend" },
        "device": { "$ref": "#/$defs/device" },
        "director": { "enum": ["rules", "llm"] },
        "llm_enabled": { "type": "boolean" },
        "model": { "$ref": "#/$defs/model" }
      }
    },
    "renderPreviewParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_dir", "shot_id"],
      "properties": {
        "project_dir": { "$ref": "#/$defs/path" },
        "resume": { "type": "boolean" },
        "force_stages": { "$ref": "#/$defs/forceStages" },
        "shot_id": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "output_path": { "$ref": "#/$defs/path" },
        "output_mode": { "enum": ["anaglyph", "left", "right", "side-by-side"] },
        "depth_backend": { "$ref": "#/$defs/depthBackend" },
        "device": { "$ref": "#/$defs/device" },
        "anaglyph_mode": { "enum": ["basic", "calibrated"] },
        "swap_eyes": { "type": "boolean" }
      }
    },
    "renderFinalParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_dir"],
      "properties": {
        "project_dir": { "$ref": "#/$defs/path" },
        "resume": { "type": "boolean" },
        "force_stages": { "$ref": "#/$defs/forceStages" },
        "output_path": { "$ref": "#/$defs/path" },
        "output_mode": { "enum": ["anaglyph", "left", "right", "side-by-side"] },
        "depth_backend": { "$ref": "#/$defs/depthBackend" },
        "device": { "$ref": "#/$defs/device" },
        "anaglyph_mode": { "enum": ["basic", "calibrated"] },
        "swap_eyes": { "type": "boolean" }
      }
    },
    "runParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_dir"],
      "properties": {
        "project_dir": { "$ref": "#/$defs/path" },
        "resume": { "type": "boolean" },
        "force_stages": { "$ref": "#/$defs/forceStages" },
        "output_path": { "$ref": "#/$defs/path" },
        "output_mode": { "enum": ["anaglyph", "left", "right", "side-by-side"] },
        "director": { "enum": ["rules", "llm"] },
        "depth_backend": { "$ref": "#/$defs/depthBackend" },
        "device": { "$ref": "#/$defs/device" },
        "anaglyph_mode": { "enum": ["basic", "calibrated"] },
        "swap_eyes": { "type": "boolean" },
        "llm_enabled": { "type": "boolean" },
        "model": { "$ref": "#/$defs/model" }
      }
    },
    "draftPerShotCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_id", "sampled_frames", "total_frames"],
      "properties": {
        "shot_id": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "sampled_frames": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "total_frames": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "draftCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_ids", "sampled_frames", "total_frames", "per_shot"],
      "properties": {
        "shot_ids": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 1000000000 }
        },
        "sampled_frames": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "total_frames": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "per_shot": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/draftPerShotCoverage" }
        }
      }
    },
    "analyzeDraftResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_tier", "profile", "features", "script", "revision", "coverage"],
      "properties": {
        "analysis_tier": { "const": "sampled" },
        "profile": { "$ref": "#/$defs/draftProfile" },
        "features": { "type": "object" },
        "script": { "type": "object" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "coverage": { "$ref": "#/$defs/draftCoverage" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "params"],
      "properties": {
        "id": { "$ref": "#/$defs/appIdentifier" },
        "method": { "$ref": "#/$defs/method" },
        "params": { "type": "object" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "method": { "const": "ping" } },
            "required": ["method"]
          },
          "then": {
            "properties": { "params": { "$ref": "#/$defs/emptyParams" } }
          }
        },
        {
          "if": {
            "properties": { "method": { "enum": ["llm_status", "test_llm"] } },
            "required": ["method"]
          },
          "then": {
            "properties": { "params": { "$ref": "#/$defs/llmParams" } }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "recommend_preset" } },
            "required": ["method"]
          },
          "then": {
            "properties": { "params": { "$ref": "#/$defs/recommendParams" } }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "apply_shot_overrides" } },
            "required": ["method"]
          },
          "then": {
            "properties": { "params": { "$ref": "#/$defs/applyShotOverridesParams" } }
          }
        },
        {
          "if": {
            "properties": { "method": { "enum": ["cancel", "cancel_job"] } },
            "required": ["method"]
          },
          "then": {
            "properties": { "params": { "$ref": "#/$defs/cancelParams" } }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "create_project" } },
            "required": ["method"]
          },
          "then": {
            "properties": { "params": { "$ref": "#/$defs/createProjectParams" } }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "inspect" } },
            "required": ["method"]
          },
          "then": {
            "properties": { "params": { "$ref": "#/$defs/inspectParams" } }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "enum": ["normalize", "detect_shots", "generate_qc", "qc", "get_project"]
              }
            },
            "required": ["method"]
          },
          "then": {
            "properties": { "params": { "$ref": "#/$defs/projectStageParams" } }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "estimate_depth" } },
            "required": ["method"]
          },
          "then": {
            "properties": { "params": { "$ref": "#/$defs/estimateDepthParams" } }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "analyze_draft" } },
            "required": ["method"]
          },
          "then": {
            "properties": { "params": { "$ref": "#/$defs/analyzeDraftParams" } }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "extract_features" } },
            "required": ["method"]
          },
          "then": {
            "properties": { "params": { "$ref": "#/$defs/extractFeaturesParams" } }
          }
        },
        {
          "if": {
            "properties": { "method": { "enum": ["create_stereo_script", "direct"] } },
            "required": ["method"]
          },
          "then": {
            "properties": { "params": { "$ref": "#/$defs/directParams" } }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "render_preview" } },
            "required": ["method"]
          },
          "then": {
            "properties": { "params": { "$ref": "#/$defs/renderPreviewParams" } }
          }
        },
        {
          "if": {
            "properties": { "method": { "enum": ["render_final", "render"] } },
            "required": ["method"]
          },
          "then": {
            "properties": { "params": { "$ref": "#/$defs/renderFinalParams" } }
          }
        },
        {
          "if": {
            "properties": { "method": { "enum": ["run_pipeline", "run"] } },
            "required": ["method"]
          },
          "then": {
            "properties": { "params": { "$ref": "#/$defs/runParams" } }
          }
        }
      ]
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "job_id", "stage", "completed", "total"],
      "properties": {
        "type": { "const": "progress" },
        "id": { "$ref": "#/$defs/appIdentifier" },
        "job_id": { "$ref": "#/$defs/appIdentifier" },
        "stage": { "type": "string", "minLength": 1, "maxLength": 128 },
        "completed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "message": { "type": "string", "maxLength": 16384 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "result"],
      "properties": {
        "type": { "const": "result" },
        "id": { "$ref": "#/$defs/appIdentifier" },
        "result": {}
      },
      "allOf": [
        {
          "if": {
            "properties": { "id": { "pattern": "^analyze-draft-" } },
            "required": ["id"]
          },
          "then": {
            "properties": { "result": { "$ref": "#/$defs/analyzeDraftResult" } }
          }
        }
      ]
    },
    "errorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9_-]+$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "details": {},
        "retryable": { "type": "boolean" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "error"],
      "properties": {
        "type": { "const": "error" },
        "id": { "$ref": "#/$defs/identifier" },
        "error": { "$ref": "#/$defs/errorBody" }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "level", "message"],
      "properties": {
        "type": { "const": "log" },
        "id": { "$ref": "#/$defs/appIdentifier" },
        "level": { "enum": ["debug", "info", "warning", "warn", "error"] },
        "message": { "type": "string", "maxLength": 16384 }
      }
    },
    "event": {
      "oneOf": [
        { "$ref": "#/$defs/progress" },
        { "$ref": "#/$defs/result" },
        { "$ref": "#/$defs/error" },
        { "$ref": "#/$defs/log" }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/event" }
  ]
}
